# --- Pipeline ---
CHUNK_CHARS=50000
CHUNK_OVERLAP=1500
MAX_EVIDENCE=20
MIN_QUOTE_SQUASHED_CHARS=20

# --- Agent (Part C) ---
AGENT_MAX_ROUNDS=6
AGENT_MAX_TOOL_CALLS=15
AGENT_TIMEOUT_MS=90000
AGENT_MAX_CONTEXT_CHARS=120000

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000