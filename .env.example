# --- API ---
PORT=4000
MONGODB_URI=
CORS_ORIGIN=http://localhost:3000
MAX_UPLOAD_MB=25
MAX_DOCUMENTS=40

# --- LLM (OpenAI-compatible; Gemini via AI Studio) ---
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_CONCURRENCY=3
LLM_RPM=8
LLM_MAX_RETRIES=4
